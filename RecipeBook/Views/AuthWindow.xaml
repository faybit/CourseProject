<Window x:Class="RecipeBook.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecipeBook.ViewModels"
        Title="Книга рецептов — вход" Height="430" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:AuthViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Книга рецептов" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="{Binding ModeTitle}" HorizontalAlignment="Center"
                       Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock Text="Логин" />
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

            <TextBlock Text="Пароль" />
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                         Margin="0,4,0,12" />

            <TextBlock Text="Отображаемое имя"
                       Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}" />
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                     Margin="0,4,0,12" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Crimson"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}"
                    Height="32" Margin="0,0,0,8" />
            <Button Content="{Binding SwitchText}" Command="{Binding SwitchModeCommand}" Style="{StaticResource LinkButton}" />
        </StackPanel>
    </Grid>
</Window>
