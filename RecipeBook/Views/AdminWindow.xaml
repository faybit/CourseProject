<Window x:Class="RecipeBook.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecipeBook.ViewModels"
        Title="Панель администратора" Height="560" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:AdminViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Категории" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <Button Content="Добавить" Command="{Binding AddCategoryCommand}" Width="80" Margin="8,0,0,0" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Categories}" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CategoryName}" Width="140" VerticalAlignment="Center" />
                            <Button Content="Удалить" Width="70"
                                    Command="{Binding DataContext.DeleteCategoryCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,8,0">
            <TextBlock Text="Сложности" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding NewDifficultyName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <Button Content="Добавить" Command="{Binding AddDifficultyCommand}" Width="80" Margin="8,0,0,0" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Difficulties}" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DifficultyName}" Width="140" VerticalAlignment="Center" />
                            <Button Content="Удалить" Width="70"
                                    Command="{Binding DataContext.DeleteDifficultyCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Ингредиенты" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding NewIngredientName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <Button Content="Добавить" Command="{Binding AddIngredientCommand}" Width="80" Margin="8,0,0,0" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Ingredients}" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IngredientName}" Width="140" VerticalAlignment="Center" />
                            <Button Content="Удалить" Width="70"
                                    Command="{Binding DataContext.DeleteIngredientCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ErrorMessage}"
                   Foreground="Crimson" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Window>