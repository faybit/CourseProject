<Window x:Class="RecipeBook.Views.CookedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приготовленное" Height="560" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Пока пусто. Отметьте рецепт кнопкой «Приготовлено»."
                           Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="LightGray" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="380">
                                        <TextBlock Text="{Binding Recipe.Title}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="Gray"
                                                   Text="{Binding CookedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                    </StackPanel>
                                    <Button Content="Открыть рецепт" Click="OpenRecipe_Click" Width="130" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Crimson" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>